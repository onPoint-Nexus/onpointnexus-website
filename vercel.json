{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [

    { "source": "/about-us",           "destination": "https://www.onpointnexus.com/about",              "permanent": true },
    { "source": "/staff-augmentation", "destination": "https://www.onpointnexus.com/services",            "permanent": true },
    { "source": "/blogs",              "destination": "https://www.onpointnexus.com/work",                "permanent": true },
    { "source": "/blogs/:path*",       "destination": "https://www.onpointnexus.com/work",                "permanent": true },

    { "source": "/pininfarina",        "destination": "https://www.onpointnexus.com/work/pininfarina",    "permanent": true },
    { "source": "/semilynx",           "destination": "https://www.onpointnexus.com/work/semilynx",       "permanent": true },
    { "source": "/vidanta",            "destination": "https://www.onpointnexus.com/work/vidanta",        "permanent": true },
    { "source": "/clinical-trac",      "destination": "https://www.onpointnexus.com/work/clinical-trac",  "permanent": true },
    { "source": "/open-houses-direct", "destination": "https://www.onpointnexus.com/work/open-houses-direct", "permanent": true },
    { "source": "/quickheal",          "destination": "https://www.onpointnexus.com/work/quickheal",      "permanent": true },
    { "source": "/ontrack-agent",      "destination": "https://www.onpointnexus.com/work/ontrack-agent",  "permanent": true },

    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "onpointnexus.com" }],
      "destination": "https://www.onpointnexus.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/:path.(png|jpg|jpeg|svg|ico|webp|woff2|woff)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    }
  ]
}
